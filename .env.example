# Copy to .env.local. Never commit real secrets.
# Do not prefix service-role keys, SMTP passwords, or JWT secrets with NEXT_PUBLIC_.

NEXTAUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=
UPLOAD_SECRET_KEY=
ENCRYPTION_KEY=
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local corporate SSL inspection only (never set on Vercel/production)
# ALLOW_INSECURE_TLS=1

# Identity verification (candidate interview gate) — local FaceNet / browser face-api
IDENTITY_MIN_CONFIDENCE=70
# FACE_MATCH_SERVICE_URL=
# FACE_MATCH_API_KEY=
# FACE_MATCH_TIMEOUT_MS=90000

# Employee portal JWT signing (required in production)
EMPLOYEE_AUTH_SECRET=

# Microsoft Entra ID SSO for Employee Portal
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
