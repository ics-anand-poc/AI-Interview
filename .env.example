# =============================================================================
# AI-Interview-POC - Environment Template (.env.example)
# Copy to .env.local at the PROJECT ROOT and fill in real values.
# Both Backend and Frontend load this one shared root file.
# =============================================================================

# --- Shared Configuration (Frontend & Backend) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FACEPROJ_SERVICE_URL=http://localhost:8000
FACE_MATCH_KEY=
EMPLOYEE_AUTH_SECRET=
ADMIN_PASSWORD=12345
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# --- Backend-only Configuration (FastAPI / faceproj) ---
FRONTEND_ORIGIN=http://localhost:3000
YOLO_WEIGHTS=./faceproj/yolo11n.pt
YOLO_CONF_THRESHOLD=0.5

# --- Frontend-only Configuration (Next.js) ---
NEXTAUTH_SECRET=
OPENAI_API_KEY=
REDIS_URL=
UPLOAD_SECRET_KEY=
ENCRYPTION_KEY=
NODE_ENV=development
USE_SUPABASE_PRIMARY=1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI Provider Selection ---
# Supported values: gemini | groq | ollama | copilot (defaults to "gemini" if unset)
AI_PROVIDER=groq

# Gemini (Google Generative AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# GitHub Copilot
COPILOT_API_KEY=
COPILOT_API_BASE_URL=https://api.microsoftcopilot.com
COPILOT_MODEL=gpt-4o
COPILOT_INTEGRATION_ID=

# AI Cache Configuration
AI_CACHE_ENABLED=true
AI_CACHE_TTL_MS=600000

# --- SMTP Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ResumePro Automated HR" <user@example.com>

# --- Microsoft Entra ID (Azure AD) SAML 2.0 SSO ---
MICROSOFT_TENANT_ID=
SAML_ISSUER=
SAML_IDP_CERT=
