# Copy to .env.azure on the app VM (or set as Container App secrets) and fill
# in real values. .env.azure is git-ignored — never commit it.
#
# Build-time args (also passed as docker build --build-arg in
# docker-compose.azure.yml): NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_APP_URL

# --- Supabase (Postgres + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# The service_role secret, NOT the anon key — pasting the anon key here
# silently breaks every RLS-protected write (signup, test scoring, etc).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- App URL (must match the public hostname / Azure Load Balancer DNS) ---
NEXT_PUBLIC_APP_URL=http://bizx-skillsphere.eastus.cloudapp.azure.com

# --- Auth & admin ---
# Generate with: openssl rand -hex 32   (keep stable — rotating logs everyone out)
EMPLOYEE_AUTH_SECRET=generate-a-long-random-string-here
ADMIN_PASSWORD=change-me

# --- Microsoft Entra ID SAML 2.0 SSO for Employee Portal ---
# Azure AD Enterprise Application → SAML SSO setup:
#   Identifier (Entity ID) -> SAML_ISSUER
#   Reply URL (ACS URL)    -> {NEXT_PUBLIC_APP_URL}/api/employee/auth/saml/acs
#   SAML Signing Certificate (Base64) -> SAML_IDP_CERT
# SP metadata for upload instead of hand-entering the above:
#   GET {NEXT_PUBLIC_APP_URL}/api/employee/auth/saml/metadata (once SAML_ISSUER is set)
MICROSOFT_TENANT_ID=d420b80d-bc1a-429d-b6c6-587896c20153
# SAML_ENTRY_POINT=https://login.microsoftonline.com/d420b80d-bc1a-429d-b6c6-587896c20153/saml2
SAML_ISSUER=
SAML_IDP_CERT=
# SAML_CALLBACK_URL=http://bizx-skillsphere.eastus.cloudapp.azure.com/api/employee/auth/saml/acs
# SAML_SP_PRIVATE_KEY=
# SAML_SP_CERT=

# --- AI provider ---
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# Alternative providers (only the selected AI_PROVIDER's key is required)
GEMINI_API_KEY=
COPILOT_API_KEY=
COPILOT_API_BASE_URL=
COPILOT_INTEGRATION_ID=

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# --- Container runtime (set automatically in the Dockerfile; override only if needed) ---
CONTAINER=1
USE_SUPABASE_PRIMARY=1
DOCS_USE_CLOUD=1
UPLOADS_DIR=/app/uploads
