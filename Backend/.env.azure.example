# Backend (FastAPI + faceproj) — Azure/container deployment reference.
# Copy to .env.azure at the PROJECT ROOT and fill in real values; both
# Backend and Frontend containers read that one root file via env_file: in
# Backend/docker-compose.azure.yml.

# --- Shared with Frontend ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
FACEPROJ_SERVICE_URL=
FACE_MATCH_KEY=
EMPLOYEE_AUTH_SECRET=generate-a-long-random-string-here
ADMIN_PASSWORD=change-me
NEXT_PUBLIC_BACKEND_URL=https://your-backend-domain.example.com

# --- Backend-only ---
FRONTEND_ORIGIN=http://localhost:3000
YOLO_WEIGHTS=./faceproj/yolo11n.pt
YOLO_CONF_THRESHOLD=0.5

# --- Container runtime ---
CONTAINER=1
USE_SUPABASE_PRIMARY=1
DOCS_USE_CLOUD=1
UPLOADS_DIR=/app/uploads
