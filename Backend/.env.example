# Backend (FastAPI + faceproj) — local development reference.
# Copy to .env.local at the PROJECT ROOT (not this folder) and fill in real
# values; both Backend and Frontend load that one root file. See ../README.md
# and item 14 of the migration notes for why there's one shared file.

# --- Shared with Frontend (Supabase, faceproj, shared secrets) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FACEPROJ_SERVICE_URL=
FACE_MATCH_KEY=
EMPLOYEE_AUTH_SECRET=
ADMIN_PASSWORD=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# --- Backend-only ---
FRONTEND_ORIGIN=http://localhost:3000
YOLO_WEIGHTS=./faceproj/yolo11n.pt
YOLO_CONF_THRESHOLD=0.5
